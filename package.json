{
  "name": "youtube-speed-enhancement",
  "version": "0.0.1",
  "description": "A browser extension (Chromium + Firefox) to enhance YouTube speed controls, written in TypeScript and bundled with esbuild",
  "keywords": [
    "web-extension",
    "youtube",
    "video",
    "playback-speed"
  ],
  "author": "sei",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build-prod": "node scripts/build.mjs --production --clean",
    "build-packed": "node scripts/build.mjs --production --clean --pack",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "svelte": "^5.57.0",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^6.0.0"
  }
}
